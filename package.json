{
  "name": "fobo",
  "main": "expo-router/entry",
  "workspaces": [
    "server",
    "packages/*"
  ],
  "version": "1.0.0",
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo/ui": "~57.0.22",
    "expo": "~57.0.27",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-android-widget": "^0.22.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@neon/config": "^1.8.6",
    "@types/react": "~19.2.2",
    "react-native-svg-transformer": "^1.5.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "dev": "expo start --web",
    "dev:all": "node scripts/dev-all.mjs",
    "build:android": "eas build --profile development --platform android",
    "build:ios": "eas build --profile development --platform ios",
    "build:ios:store": "eas build --profile production --platform ios --auto-submit",
    "server": "npm run dev -w fobo-server",
    "migrate": "npm run migrate -w fobo-server",
    "start": "expo start --tunnel",
    "start:lan": "expo start",
    "web": "expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "tokens": "node scripts/gen-tokens.mts",
    "typecheck": "tsc --noEmit"
  },
  "private": true
}
